# Admin dashboard login
ADMIN_EMAIL=admin@cinem.tech
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Keep true on a real HTTPS domain. Set false only for local HTTP testing.
ADMIN_COOKIE_SECURE=true

# Optional but recommended: Base32 secret enrolled in an authenticator app.
ADMIN_TOTP_SECRET=

# Exactly 32 bytes encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENQUIRY_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Use an absolute path on a persistent disk in production.
# CINEM_DB_PATH=/var/lib/cinem/cinem.sqlite

# Optional: enables AI proposal refinement. Without it, the smart template fallback still works.
OPENAI_API_KEY=
OPENAI_PROPOSAL_MODEL=gpt-5.4

# Optional analytics; scripts load only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
